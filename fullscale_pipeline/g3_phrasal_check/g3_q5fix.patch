+            return None
+        e = e[1]
+    return e if e.type().startswith('P') else None
+
+
+def replace_atom(e, old, new):
+    if e.is_atom():
+        return new if e is old else e
+    return hedge(tuple(replace_atom(c, old, new) for c in e))
